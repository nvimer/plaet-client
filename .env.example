# ===============================================
# VARIABLES DE ENTORNO - CONFIGURACION DE API
# ===============================================

# IMPORTANTE: Las variables de entorno DEBEN empezar con VITE_
# para ser accesibles en el codigo del navegador

# ===============================================
# CONFIGURACION LOCAL (DESARROLLO)
# ===============================================
# Cuando desarrollas localmente, la API esta en:
VITE_API_URL=http://localhost:8080

# ===============================================
# CONFIGURACION DE PRODUCCION (RAILWAY)
# ===============================================
# Cuando deployas en Railway, tu API estara en:
# REEMPLAZA 'tu-app-name' con el nombre de tu proyecto en Railway
# VITE_API_URL=https://tu-app-name.railway.app

# ===============================================
# SUPABASE (nvimer account)
# ===============================================
VITE_DB_URL=https://alkrxrcpdxecpzgykbrz.supabase.co
VITE_DB_ANON_KEY=YOUR-ANON-KEY

# ===============================================
# NOTAS TECNICAS
# ===============================================
# 1. El prefijo /api/v1 se agrega automaticamente en constants.ts
# 2. Timeout de API: 10 segundos
# 3. Cache de React Query: 5 minutos
# 4. Revalidacion automatica configurada en hooks
# ===============================================
